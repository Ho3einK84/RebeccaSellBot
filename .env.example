NODE_ENV=development
BOT_TOKEN=123456:replace_me
ADMIN_IDS=123456789
DATABASE_URL=postgres://rsbot_user:replace_me@localhost:5432/rsbot_db
# Stable encryption key for credentials stored by the in-bot panel manager.
# Generate with: openssl rand -hex 32
PANEL_CREDENTIALS_KEY=replace_with_a_random_64_character_hex_value
# Optional legacy single-panel import. New installations should leave these
# empty and configure panels from /admin → Rebecca panels.
REBECCA_API_URL=
REBECCA_API_KEY=
REBECCA_ADMIN_USERNAME=admin
REBECCA_ADMIN_PASSWORD=
REBECCA_SERVICE_ID=1
HEALTH_CHECK_PORT=3001
DEFAULT_LOCALE=fa
