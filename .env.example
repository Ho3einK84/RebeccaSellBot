NODE_ENV=development
BOT_TOKEN=123456:replace_me
ADMIN_IDS=123456789
# Optional: override the support button (defaults to the first ADMIN_IDS entry)
# SUPPORT_URL=https://t.me/your_support
DATABASE_URL=postgres://rsbot_user:replace_me@localhost:5432/rsbot_db
# Stable encryption key for credentials stored by the in-bot panel manager.
# Generate with: openssl rand -hex 32
PANEL_CREDENTIALS_KEY=replace_with_a_random_64_character_hex_value
# Optional legacy single-panel import. New installations should leave these
# empty and configure panels from /admin → Rebecca panels.
REBECCA_API_URL=
REBECCA_API_KEY=
REBECCA_ADMIN_USERNAME=admin
REBECCA_ADMIN_PASSWORD=
REBECCA_SERVICE_ID=1
HEALTH_CHECK_PORT=3001
DEFAULT_LOCALE=fa

# Unified port for external application hosting / PaaS (systemd, Docker, Render, etc.)
# If set, overrides WEBHOOK_PORT and HEALTH_CHECK_PORT defaults for single-port operation.
# PORT=3000

# Delivery mode: 'polling' (default) or 'webhook'
BOT_DELIVERY_MODE=polling

# Webhook configuration (required if BOT_DELIVERY_MODE=webhook)
# WEBHOOK_URL=https://example.com/rsbot/webhook
# WEBHOOK_SECRET_TOKEN=replace_with_a_secure_random_string_123
# WEBHOOK_PORT=3000
# WEBHOOK_PATH=/rsbot/webhook
# WEBHOOK_HOST=0.0.0.0
# Published host port for reverse proxy (Caddy / Nginx):
# WEBHOOK_HOST_PORT=3000
# WEBHOOK_BIND_HOST=127.0.0.1

# Rebecca Panel Inbound Webhooks (instant event push for user_limited, user_expired, etc.)
# REBECCA_WEBHOOK_SECRET=replace_with_webhook_secret_matching_rebecca_panel
# REBECCA_WEBHOOK_PATH=/api/rebecca-webhook

