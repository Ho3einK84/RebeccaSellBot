{
  "name": "rsbot",
  "version": "0.3.0",
  "private": true,
  "description": "RebeccaSellBot - Telegram VPN sales bot for Rebecca Panel (REST API only)",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/Ho3einK84/RebeccaSellBot#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ho3einK84/RebeccaSellBot.git"
  },
  "bugs": {
    "url": "https://github.com/Ho3einK84/RebeccaSellBot/issues"
  },
  "keywords": [
    "telegram-bot",
    "rebecca-panel",
    "vpn-sales",
    "grammy",
    "typescript",
    "drizzle-orm",
    "postgresql"
  ],
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "build:webapp": "vite build --config webapp/vite.config.ts",
    "dev:webapp": "vite --config webapp/vite.config.ts",
    "build": "npm run build:webapp && node scripts/build.mjs",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "db:migrate": "node dist/infra/migrate.js",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:studio": "drizzle-kit studio",
    "typecheck:root": "tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/root.tsbuildinfo",
    "typecheck:webapp": "tsc -p webapp/tsconfig.json --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/webapp.tsbuildinfo",
    "typecheck": "node scripts/verify.mjs --only=typecheck",
    "lint": "eslint --cache --cache-location node_modules/.cache/eslint/.eslintcache .",
    "format": "prettier --write .",
    "format:check": "prettier --check --cache --cache-location node_modules/.cache/prettier/.prettiercache .",
    "test": "vitest run",
    "test:changed": "vitest run --changed",
    "test:coverage": "vitest run --coverage",
    "architecture:check": "node scripts/check-architecture.mjs",
    "verify": "node scripts/verify.mjs",
    "verify:fast": "node scripts/verify.mjs --changed",
    "verify:cold": "node scripts/verify.mjs --no-cache",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/cors": "11.4.3",
    "@fastify/jwt": "10.2.8",
    "@fastify/rate-limit": "11.2.2",
    "@fastify/static": "10.1.11",
    "@grammyjs/conversations": "2.1.1",
    "@grammyjs/menu": "1.5.0",
    "@grammyjs/transformer-throttler": "1.2.1",
    "dotenv": "18.0.10",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "grammy": "1.46.0",
    "node-cron": "4.6.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "qrcode": "1.5.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/react-query": "5.108.1",
    "@types/node": "26.6.6",
    "@types/node-cron": "3.0.11",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "daisyui": "5.8.1",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "lucide-react": "1.76.0",
    "pino-pretty": "13.2.0",
    "prettier": "3.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.0.5"
  }
}
